#!/bin/bash
set -e

SELF=$(readlink -f "$0")
HERE=${SELF%/*}
APPDIR="${HERE}/usr"

# --- Desktop integration (runs once per AppImage location) ---
APP_ID="com.sciometa.osd"
APP_NAME="Sciometa OSD"
APPIMAGE_PATH="${APPIMAGE:-$SELF}"

if [ -n "$APPIMAGE_PATH" ] && [ -f "$APPIMAGE_PATH" ]; then
    ICON_SRC="${HERE}/${APP_ID}.png"
    ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
    DESKTOP_DIR="$HOME/.local/share/applications"
    SHORTCUT_DIR="$HOME/Desktop"

    # Install icon (always update to ensure latest icon)
    if [ -f "$ICON_SRC" ]; then
        mkdir -p "$ICON_DIR"
        cp "$ICON_SRC" "$ICON_DIR/$APP_ID.png"
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor/" 2>/dev/null || true
    fi

    # Create .desktop entry in application menu
    DESKTOP_FILE="$DESKTOP_DIR/$APP_ID.desktop"
    if [ ! -f "$DESKTOP_FILE" ] || ! grep -q "$APPIMAGE_PATH" "$DESKTOP_FILE" 2>/dev/null; then
        mkdir -p "$DESKTOP_DIR"
        cat > "$DESKTOP_FILE" << EOF
[Desktop Entry]
Type=Application
Name=$APP_NAME
Comment=Order Status Display for restaurants
Exec=$APPIMAGE_PATH
Icon=$APP_ID
Categories=Office;Finance;
Terminal=false
StartupNotify=true
EOF
    fi

    # Create desktop shortcut
    SHORTCUT="$SHORTCUT_DIR/$APP_NAME.desktop"
    if [ -d "$SHORTCUT_DIR" ]; then
        if [ ! -f "$SHORTCUT" ] || ! grep -q "$APPIMAGE_PATH" "$SHORTCUT" 2>/dev/null; then
            cp "$DESKTOP_FILE" "$SHORTCUT"
            chmod +x "$SHORTCUT"
            gio set "$SHORTCUT" metadata::trusted true 2>/dev/null || true
        fi
    fi
fi

# --- Launch app ---
export LD_LIBRARY_PATH="${APPDIR}/lib:${LD_LIBRARY_PATH}"
export GTK_THEME="${GTK_THEME:-Adwaita}"
export XDG_DATA_DIRS="${APPDIR}/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

cd "${APPDIR}"
exec "${APPDIR}/osd_app" "$@"
